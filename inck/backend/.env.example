# Copy to .env.local for local development (npm run dev loads it).
# In production these live in /srv/apps/inck/.env on the server.

# Local: the embedded dev database started by `npm run dev` (dev:db).
# Production: postgres://inck:<password>@<rds-endpoint>:5432/inck?sslmode=require
DATABASE_URL=postgres://inck:inck@localhost:5433/inck?sslmode=disable

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Login for /admin
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Where generated images are stored (default: ../data next to the backend folder)
# DATA_DIR=/srv/apps/inck/data
